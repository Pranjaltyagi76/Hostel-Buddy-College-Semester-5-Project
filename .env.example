# Hostel Buddy — environment configuration
# Copy this file to ".env" and adjust the values.

# Server
PORT=4000
NODE_ENV=development

# Authentication
JWT_SECRET=change-me-to-a-long-random-secret

# Seeded administrator account (created on first run)
ADMIN_EMAIL=admin@hostel.test
ADMIN_PASSWORD=admin123
ADMIN_NAME=Hostel Administrator

# Demo-only exception: set true only when deliberately retaining the default
# administrator password for an academic demo. Never use with real student data.
ALLOW_DEMO_ADMIN_PASSWORD=false

# Logging — how much of the request stream to print.
#   api  (default) every /api request, plus anything that failed
#   all            every request, static assets included
#   none           silence
LOG_LEVEL=api

# Storage
DB_PATH=./data/hostel.db
UPLOAD_DIR=./uploads

# Required on Vercel. Leave blank for local SQLite in development.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
